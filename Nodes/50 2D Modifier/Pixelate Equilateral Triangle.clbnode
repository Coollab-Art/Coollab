#include "_COOL_RES_/shaders/hexagonal_grid.glsl"
#include "_COOL_RES_/shaders/triangle_grid.glsl"

INPUT float 'Grid Size';

OUTPUT float 'Index X';
OUTPUT float 'Index Y';

UV main(UV uv)
{
    ivec2 id = Cool_tri_id(uv, 'Grid Size' / 2);
    'Index X' = id.x;
    'Index Y' = id.y;
    return(Cool_tri_center_from_tri_id(id, 'Grid Size'));
