// To learn how to write nodes, see https://coollab-art.com/Tutorials/Writing%20Nodes/Intro

INPUT float 'Exposant';

float main(float Input)
{
    if (floor('Exposant') == 'Exposant')
    {
        float res = 1;
        for (int i = 0; i < int(abs('Exposant')); i++)
        {
            res *= Input;
        }
        return ('Exposant' < 0)?1/res:res;
    }
    return pow(Input, 'Exposant');
}