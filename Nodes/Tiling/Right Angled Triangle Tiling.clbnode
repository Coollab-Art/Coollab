INPUT float 'Cell Size';
INPUT int 'Mode';

Tiling main(UV uv){
    Tiling tile;

    float cell_size = 2 * 'Cell Size';
    uv = uv / cell_size;
    vec2 gv = floor(uv);
    vec2 dec = uv - gv;
    ivec2 id = ivec2(floor(uv));
    id.x *= 2;

    // Up Left -> Down Right
    if ('Mode' == 0)
    {
        if (dec.y + dec.x > 1)
        {
            gv += .75;
            id.x++;
        }
        else
        {
            gv += .25;
        }
    }
    // Up Right -> Down Left
    else // ('Mode' == 1)
    {
        if (1 - dec.y + dec.x > 1)
        {
            gv.x += .75;
            gv.y += .25;
            id.x++;
        }
        else
        {
            gv.x += .25;
            gv.y += .75;
        }
    }

    vec2  uv2 = uv / cell_size - 0.5;
    vec2 ret = normalize_uv_with_aspect_ratio(fract(uv2), 1.);
   
    tile.uv = ret;
    tile.id = id;
    tile.center = gv * cell_size;
    return tile;
}