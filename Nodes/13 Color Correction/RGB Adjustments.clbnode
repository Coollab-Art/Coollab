// To learn how to write nodes, see https://coollab-art.com/Tutorials/Writing%20Nodes/Intro

INPUT float 'Red shift';
INPUT float 'Green shift';
INPUT float 'Blue shift';

float curve(float x, float a)
{
    return (-1. < a && a < 1.) ? 
        pow(x, 2. / (a + 1.) - 1.)
        :
        (a <= -1. ?
            0.
            :
            1.
        )
    ;
}

LinearRGB main(LinearRGB Color)
{   
    float original_gray = Cool_Okhsl_from_LinearRGB(Color).z;

    vec3 ColorLinear = vec3(
        curve(Color.x, 'Red shift'),
        curve(Color.y, 'Green shift'),
        curve(Color.z, 'Blue shift')
    );
    
    vec3 ColorOkhsl = Cool_Okhsl_from_LinearRGB(ColorLinear);
    ColorOkhsl.z = original_gray;
    ColorLinear = Cool_LinearRGB_from_Okhsl(ColorOkhsl);

    return ColorLinear;
}