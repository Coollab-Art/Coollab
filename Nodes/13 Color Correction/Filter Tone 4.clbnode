INPUT float 'Shadows';
INPUT float 'Highlights';
INPUT float 'Midtones';


float gauss(float x, float abcisse_sommet, float hauteur_sommet, float ecart_type)
{
    return hauteur_sommet * exp(-0.5 * pow(x - abcisse_sommet, 2) / (ecart_type * ecart_type));
}

float ponderation(float x, float ampleur)
{
    float coeff = ampleur < 0. ? x : 1. - x;
    return coeff * (1. - pow(2. * x - 1., 20));
}

float deformation(float x, float abcisse_sommet, float ampleur, float ecart_type)
{
    return gauss(x, abcisse_sommet, ampleur, ecart_type) * ponderation(x, ampleur);
}

float filter_tone(float x, float shadows, float highlights, float midtones)
{
    return x + deformation(x, 0., 0.5 * shadows, 0.2) + deformation(x, 1., 0.5 * highlights, 0.2);
}

Okhsl main(Okhsl Image)
{
    float shadows    = 'Shadows';
    float highlights = 'Highlights';
    float midtones   = 'Midtones';

    return vec3(
        Image.x,
        Image.y,
        filter_tone(Image.z, shadows, highlights, midtones)
    );
}
