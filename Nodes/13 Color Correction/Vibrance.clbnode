// https://stackoverflow.com/questions/33966121/what-is-the-algorithm-for-vibrance-filters

INPUT float 'Level of vibrance';

float vmax(vec3 v)
{
    return max(max(v.x, v.y), v.z);
}

float vmin(vec3 v)
{
    return min(min(v.x, v.y), v.z);
}

sRGB main(sRGB Color)
{

    float red = Color.x;
    float green = Color.y;
    float blue = Color.z;

    float maximum_color = vmax(Color);
    float minimum_color = vmin(Color);

    float original_gray = Cool_Oklab_from_sRGB(Color).x;
    
    float scale = 'Level of vibrance' * 0.6;

    float range = maximum_color - minimum_color;

    // Lessen the effect when red is dominant to protect skin tones
    scale = 
        (maximum_color == red ?
        scale * (1 + min(1, abs((green - blue) / range))) * 0.5
        :
        scale
        )
    ;

    float scale1 = scale * (2 - range);
    float scale2 = 1 + scale1 * (1 - range);

    // Change vibrance
    vec3 ColorLinear = Cool_LinearRGB_from_sRGB(vec3(red, green, blue) * scale2 - vec3(minimum_color * scale1));

    float modified_gray = Cool_Oklab_from_LinearRGB(ColorLinear).x;

    // Change the luminosity back to the orginal one
    vec3 ColorOklab = Cool_Oklab_from_LinearRGB(ColorLinear);
    ColorOklab.x = original_gray;
    ColorLinear = Cool_LinearRGB_from_Oklab(ColorOklab);

    float new_maximum_color = vmax(ColorLinear);
    scale = (1 - modified_gray) / (new_maximum_color - modified_gray);

    // In case a color channel is too high
    ColorLinear = 
        (new_maximum_color > 1 ?
            (ColorLinear - vec3(modified_gray)) * scale + vec3(modified_gray)
            :
            ColorLinear
        )
    ;

    return Cool_sRGB_from_LinearRGB(ColorLinear);
}