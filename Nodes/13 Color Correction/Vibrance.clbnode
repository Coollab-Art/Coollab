// https://stackoverflow.com/questions/33966121/what-is-the-algorithm-for-vibrance-filters

INPUT float 'Level of vibrance';

float vmax(vec3 v)
{
    return max(max(v.x, v.y), v.z);
}

float vmin(vec3 v)
{
    return min(min(v.x, v.y), v.z);
}

sRGB main(sRGB Color)
{

    float r = Color.x;
    float g = Color.y;
    float b = Color.z;

    float x = vmax(Color);
    float y = vmin(Color);

    float gray = Cool_Oklab_from_sRGB(Color).x;
    
    float scale = 'Level of vibrance' * 0.6;

    float a = x - y;

    scale = 
        (x == r ?
        scale * (1 + min(1, abs((g - b) / a))) * 0.5
        :
        scale
        )
    ;

    float scale1 = scale * (2 - a);
    float scale2 = 1 + scale1 * (1 - a);

    vec3 ColorLinear = Cool_LinearRGB_from_sRGB(vec3(r, g, b) * scale2 - vec3(y * scale1));

    float gray2 = Cool_Oklab_from_LinearRGB(ColorLinear).x;

    //ColorLinear *= gray / gray2;
    vec3 ColorOklab = Cool_Oklab_from_LinearRGB(ColorLinear);
    ColorOklab.x = gray2 == 1 ? 0 : gray;
    ColorLinear = Cool_LinearRGB_from_Oklab(ColorOklab);

    float m = vmax(ColorLinear);

    scale = (1 - gray2) / (m - gray2);
    ColorLinear = 
        (m > 1 ?
            (ColorLinear - vec3(gray2)) * scale + vec3(gray2)
            :
            ColorLinear
        )
    ;

    //return Cool_sRGB_from_Okhsl(vec3(0, 0, Cool_Oklab_from_LinearRGB(ColorLinear).x));
    return Cool_sRGB_from_LinearRGB(ColorLinear);
}